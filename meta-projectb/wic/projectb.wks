# short-description: SD card image for BeagleBone Black (Project B)
# Same layout as meta-yocto-bsp beaglebone-yocto.wks, but extlinux.conf comes from
# projectb-extlinux.conf in this layer (bootloader --configfile) instead of being
# generated by wic. Root device is /dev/mmcblk0p2: the SD card is always mmcblk0 on
# this board (eMMC is mmcblk1), and a custom configfile cannot know wic's PARTUUID.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4 --fixed-size 32 --sourceparams="loader=u-boot" --use-uuid
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 4 --use-uuid
bootloader --configfile=projectb-extlinux.conf
