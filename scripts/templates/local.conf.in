# Sinh bởi scripts/setup-build.sh. Sửa file này trong repo, không sửa tay trong build dir.

MACHINE = "beaglebone-yocto"
DISTRO ?= "poky"

# Init system: systemd thay cho sysvinit mặc định của Poky. Đây là thiết lập cấp distro
# (đổi DISTRO_FEATURES), không đặt riêng cho từng image được. Kéo theo: ROOT_HOME thành
# /root, init-ifupdown biến mất, mạng do systemd-networkd cấu hình (80-wired.network, DHCP).
INIT_MANAGER = "systemd"

# Kernel PREEMPT_RT (tuần 3). Bỏ dòng này để về linux-yocto thường (sstate giữ cả hai,
# đổi qua lại chỉ build lại image). Mốc non-RT: ~/projectb-baseline/.
PREFERRED_PROVIDER_virtual/kernel = "linux-yocto-rt"

# Kernel debug (lockdep, DEBUG_ATOMIC_SLEEP, hậu tố -debug) trong lúc viết driver.
# Đặt "0" trước khi đo thời gian/benchmark. Đổi giá trị thì build lại cả module ngoài cây.
# Ảnh nộp GĐ1 (tuần 8): "0", RT không debug. Bản RT debug ở ~/projectb-baseline/rt-debug-20261030/.
PROJECTB_KERNEL_DEBUG = "0"

# Chỉ dùng khi phát triển: root không mật khẩu (empty-root-password) để vào qua serial.
# Không có allow-empty-password: cờ đó đặt PermitEmptyPasswords yes trong sshd_config, khi đó
# sshd cho vào bằng phương thức "none" với root::, SSH không cần khóa (đã gặp 2026-10-20).
# Không đưa vào image sản phẩm.
EXTRA_IMAGE_FEATURES ?= "empty-root-password allow-root-login"

# Cache mã nguồn, nằm ngoài git (xem .gitignore)
DL_DIR = "@WORKSPACE@/downloads"

# Máy build: 14GB RAM, 12 luồng. Khoảng 2GB RAM cho mỗi job biên dịch.
BB_NUMBER_THREADS = "3"
PARALLEL_MAKE = "-j 3"
